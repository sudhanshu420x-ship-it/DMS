# Copy this file to .env for local configuration (do not commit real secrets!)
# On Vercel, add these under Project Settings -> Environment Variables.

# Map API Key (Mapbox public token starting with pk., or MapTiler API key)
# Leave empty to use free CartoDB Dark tiles + OSRM routing.
MAP_API_KEY=

# Optional provider override: auto | mapbox | mapbox-satellite | maptiler | carto
MAP_PROVIDER=auto

# Flask session secret key
SECRET_KEY=change-this-demo-secret-key
